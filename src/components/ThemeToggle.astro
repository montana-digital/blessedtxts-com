<button
  id="themeToggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle light or dark theme"
>
  <svg width="28" height="28" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
    <g class="theme-toggle__sun" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 3v1m0 16v1m-9-9h1m16 0h1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"></path>
    </g>
    <path
      class="theme-toggle__moon"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3a6 6 0 0 0 9 9a9 9 0 1 1-9-9"
    ></path>
  </svg>
</button>

<script>
  const themeToggle = () => {
    const el = document.documentElement;
    const isDark = !el.classList.contains('dark');
    el.classList.toggle('dark', isDark);
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (_) {}
  };

  document.getElementById('themeToggle')?.addEventListener('click', themeToggle);
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    border-radius: 8px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle__sun,
  .theme-toggle__moon {
    transform-origin: center;
    transition:
      transform 300ms ease-in-out,
      opacity 250ms ease-in-out;
  }

  .theme-toggle__sun {
    stroke: currentColor;
    fill: none;
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle__moon {
    fill: transparent;
    stroke: none;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  :global(html.dark) .theme-toggle__sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global(html.dark) .theme-toggle__moon {
    fill: currentColor;
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>
