---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VERSIONS } from '../../lib/bible-config';
import { breadcrumbJsonLd } from '../../lib/seo';
import { GITHUB_REPO_URL, pageTitle } from '../../site.config';
---

<BaseLayout
  title={pageTitle('About')}
  description="Learn about Blessed Texts—a free Bible reader for King James, World English, and Webster translations. No account required; read and search online."
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'About' },
  ])}
>
  <h1>About Blessed Texts</h1>
  <p class="subtitle">An independent project to help you read and navigate the Bible</p>

  <div class="about-content">
    <p>
      Blessed Texts is an independent project built to make reading and exploring Scripture simple and accessible.
      Browse books and chapters, search verses, compare translations, and discover passages — all free, with no account required.
    </p>

    <p class="about-github">
      <a
        href={GITHUB_REPO_URL}
        rel="noopener noreferrer"
        target="_blank"
        aria-label="View Blessed Texts on GitHub"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span class="about-github__label">GitHub</span>
      </a>
    </p>

    <h2>Available translations</h2>
    <p>We currently offer three Bible translations:</p>
    <ul class="about-translations">
      {Object.values(VERSIONS).map((v) => (
        <li>
          <a href={`/translations/${v.routeSlug}/`}>{v.label}</a>
          —
          <a href={`/${v.routeSlug}/read/`}>read online</a>
        </li>
      ))}
    </ul>

    <p>
      Bible text offered here is public domain where applicable. You may also
      <a href="/downloads/">download</a> plain-text and Markdown files, open a
      <a href="/king-james-bible/genesis/1/">chapter page</a>, explore
      <a href="/topics/">verse topics</a>, or read the <a href="/llms.txt">AI site guide (llms.txt)</a>.
    </p>

    <p>
      We are happy to add more translations. If you have a suggestion or would like to contribute,
      please <a href="/contact/">reach out</a>.
    </p>
  </div>
</BaseLayout>
