---
import RedirectLayout from '@/layouts/RedirectLayout.astro';
import { getAllChapterPaths } from '@/lib/content';
import { absoluteUrl } from '@/lib/seo';

export function getStaticPaths() {
  return getAllChapterPaths();
}

const { version: routeSlug, book: bookSlug, chapter: chapterStr } = Astro.params;
const href = `/${routeSlug}/read/#${bookSlug}-${chapterStr}`;
---

<RedirectLayout
  canonical={absoluteUrl(`/${routeSlug}/read/`)}
  message="Redirecting to the Bible reader…"
  href={href}
>
  <script slot="script" is:inline define:vars={{ routeSlug, bookSlug, chapterStr }}>
    const v = location.hash.match(/^#v(\d+)$/);
    const suffix = v ? `-v${v[1]}` : '';
    const target = `/${routeSlug}/read/#${bookSlug}-${chapterStr}${suffix}`;
    location.replace(target);
  </script>
</RedirectLayout>
