---
import RedirectLayout from '@/layouts/RedirectLayout.astro';
import { getAllBookPaths } from '@/lib/content';
import { absoluteUrl } from '@/lib/seo';

export function getStaticPaths() {
  return getAllBookPaths();
}

const { version: routeSlug, book: bookSlug } = Astro.params;
const href = `/${routeSlug}/read/#${bookSlug}-1`;
---

<RedirectLayout
  canonical={absoluteUrl(`/${routeSlug}/read/`)}
  message="Redirecting to the Bible reader…"
  href={href}
/>
